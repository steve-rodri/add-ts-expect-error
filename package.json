{
  "name": "add-ts-expect-error",
  "version": "1.0.0",
  "description": "Adds a @ts-expect-error comment above every type error in a TypeScript project, with the error message inline. JSX aware.",
  "license": "ISC",
  "author": "Steve Rodriguez",
  "homepage": "https://github.com/steve-rodri/add-ts-expect-error#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steve-rodri/add-ts-expect-error.git"
  },
  "bugs": {
    "url": "https://github.com/steve-rodri/add-ts-expect-error/issues"
  },
  "keywords": [
    "typescript",
    "ts-expect-error",
    "ts-ignore",
    "codemod",
    "cli",
    "strict-mode",
    "migration",
    "jsx",
    "tsx",
    "ts-morph"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "add-ts-expect-error": "dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "start": "tsx src/index.ts"
  },
  "dependencies": {
    "ts-morph": "^23.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.2.0",
    "@vitest/ui": "^2.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "prettier": {
    "semi": false
  }
}
